 {ign:"NXvesRYUK", name:"Robiul Islam", role:"ROLE TBA", matches:"—", tournamentKills:"—", scrimKills:"—", totalKills:"—"},
 {ign:"NXvesAkaTsukI", name:"Samin Muktadir", role:"ROLE TBA", matches:"—", tournamentKills:"—", scrimKills:"—", totalKills:"—"}
];

const $ = (s, p=document) => p.querySelector(s);
const $$ = (s, p=document) => [...p.querySelectorAll(s)];

window.addEventListener("load", () => {
  setTimeout(() => $(".page-loader")?.classList.add("loaded"), 450);
  setupMenu();
  setupReveal();
  renderRoster();
  renderMiniRoster();
  renderMatches();
});

function setupMenu(){
  const toggle = $(".menu-toggle"), nav = $(".nav nav");
  toggle?.addEventListener("click", ()=>{nav.classList.toggle("open"); toggle.classList.toggle("open")});
}
function setupReveal(){
  const items = $$(".reveal");
  if(!items.length) return;
  const obs = new IntersectionObserver(es => es.forEach(e=>{if(e.isIntersecting){e.target.classList.add("in");obs.unobserve(e.target)}}), {threshold:.08});
  items.forEach(x=>obs.observe(x));
}
function playerCard(p, i){
 return `<article class="player-card reveal" style="--i:${i}">
   <div class="player-number">0${i+1}</div><div class="player-mark">N</div>
   <div class="player-main"><p class="player-ign">${p.ign}</p><h3>${p.name}</h3><span class="role">${p.role}</span></div>
   <div class="player-stats">
    <div><b>${p.matches}</b><small>MATCHES</small></div>
    <div><b>${p.tournamentKills}</b><small>TOURN. KILLS</small></div>
    <div><b>${p.scrimKills}</b><small>SCRIM KILLS</small></div>
    <div><b>${p.totalKills}</b><small>TOTAL KILLS</small></div>
   </div>
 </article>`;
}
function renderRoster(){
 const el=$("#rosterGrid"); if(el) el.innerHTML=PLAYERS.map(playerCard).join("");
}
function renderMiniRoster(){
 const el=$("#miniRoster"); if(el) el.innerHTML=PLAYERS.map((p,i)=>`<a class="mini-player" href="roster.html"><span>0${i+1}</span><div><b>${p.ign}</b><small>${p.name}</small></div><i>↗</i></a>`).join("");
}
function renderMatches(){
 const el=$("#matchesList"); if(!el) return;
 const data = [
  {status:"UPCOMING", date:"TBA", title:"NEXT COMPETITIVE MATCH", event:"Tournament / Scrim", detail:"Official schedule will be published here."},
  {status:"UPCOMING", date:"TBA", title:"NEXT TOURNAMENT", event:"PUBG MOBILE ESPORTS", detail:"Tournament information coming soon."},
  {status:"RESULT", date:"—", title:"RECENT RESULT", event:"NEXVORA E-SPORTS", detail:"Official result will be added after the event."}
 ];
 el.innerHTML=data.map((m,i)=>`<article class="match-card"><div class="match-id">0${i+1}</div><div class="match-date"><span>${m.date}</span><small>${m.status}</small></div><div class="match-title"><h3>${m.title}</h3><p>${m.event}</p></div><div class="match-detail">${m.detail}</div><span class="match-arrow">↗</span></article>`).join("");
}
''', encoding="utf-8")

